rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isOwner(docId) {
      return request.auth != null && docId.split('_')[0] == request.auth.uid;
    }

    // Existence of admins/{uid} grants admin-app access — see
    // admin/README.md for how the first admin is bootstrapped.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /hunts/{huntId} {
      allow read: if (request.auth != null && resource.data.status == 'live') || isAdmin();
      allow write: if isAdmin();
      match /stations/{document=**} { allow read, write: if isAdmin(); }
    }

    match /qrTokens/{token} { allow read: if isAdmin(); allow write: if isAdmin(); }

    match /progress/{progressId} {
      // The isOwner(progressId) branch covers get(); it can't be evaluated
      // for a list() query, since the rules engine can't statically prove a
      // field-filtered query only returns documents whose ID happens to
      // match that field — hence the second branch, which mirrors the
      // where('uid', '==', uid) filter the home screen's query actually
      // uses (see src/features/hunt/useMyHunts.ts).
      allow read: if isOwner(progressId) ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
      match /cards/{stationId}  { allow read: if isOwner(progressId); allow write: if false; }
      match /events/{eventId}   { allow read: if isOwner(progressId); allow write: if false; }
    }

    match /users/{uid} {
      allow read, update: if request.auth.uid == uid;
      match /pushTokens/{token} { allow read, write: if request.auth.uid == uid; }
    }

    // /redemptions/{redemptionId} has no explicit rule: Firestore denies by
    // default. Only Cloud Functions (Admin SDK) read and write it.
  }
}
