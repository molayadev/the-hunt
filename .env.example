# Not needed for local development against the Firebase emulators (npm run emulators).
# Copy to .env.local and fill in only to point the app at a real Firebase project —
# see README.md "Variables de entorno".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
